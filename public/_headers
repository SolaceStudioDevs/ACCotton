# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML is rebuilt on every deploy — always revalidate so a new build is
# picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/*/
  Cache-Control: public, max-age=0, must-revalidate

# Fonts are content-addressed by Google's filename hash and never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Reels and stills are replaced by filename, not edited in place.
/media/*
  Cache-Control: public, max-age=2592000
/img/*
  Cache-Control: public, max-age=2592000

# Content-hashed filenames, so a changed file is always a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
