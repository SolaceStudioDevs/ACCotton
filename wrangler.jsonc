{
  // Cloudflare Workers configuration.
  //
  // The site is static HTML built into dist/ and served by Workers Static
  // Assets. The Worker itself exists only to handle the contact form POST;
  // everything else is served straight from the asset store.
  "name": "accotton",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  "build": {
    // Runs before deploy so dist/ exists. Kept here rather than only in the
    // dashboard so a deploy is reproducible from the repo.
    "command": "node build.js"
  },

  // Deploys build a new version from this file, so anything added by hand in
  // the dashboard can be absent from the next build. Non-secret settings
  // belong here where every deploy will carry them.
  //
  // BRIEF_TO is the address already published on the contact page, which
  // forwards to A.C.'s inbox — deliberately not a personal address, so this
  // file stays safe to read.
  "vars": {
    "BRIEF_FROM": "briefs@send.accotton.com",
    "BRIEF_TO": "narration@accotton.com"
  },

  // RESEND_API_KEY is a secret and is set in the dashboard
  // (Settings -> Runtime variables and secrets, type Secret). It must never
  // appear in this file.

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // dist/404.html, with a real 404 status.
    "not_found_handling": "404-page",
    // /api/* — without this the asset router answers before the Worker is
    // reached and the contact form gets the 404 page instead of the handler.
    // /media/* — the asset store does not answer Range requests, so the
    // browser cannot seek within a reel. The Worker adds range support.
    "run_worker_first": ["/api/*", "/media/*"]
  },

  "observability": {
    "enabled": true
  }
}
