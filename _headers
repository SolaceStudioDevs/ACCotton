# Cloudflare Pages — response headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprint these paths (or add a hash to the filename) before raising the
# max-age — right now they are named, not versioned, so keep it modest.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Reels and photography change rarely and are replaced by filename.
/assets/audio/*
  Cache-Control: public, max-age=2592000

/assets/img/*
  Cache-Control: public, max-age=2592000
